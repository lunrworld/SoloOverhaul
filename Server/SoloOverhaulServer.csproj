<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SoloOverhaul</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <Version>0.0.1</Version>
    <!-- The two lines below will set the output path for the binaries -->
    <OutputPath>bin\$(Configuration)\$(ProjectName)\$(AssemblyName)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
	<ItemGroup>
		<PackageReference Include="SPTushonka.Common" Version="4.1.6" />
		<PackageReference Include="SPTushonka.DI" Version="4.1.6" />
		<PackageReference Include="SPTushonka.Server.Core" Version="4.1.6" />
	</ItemGroup>
  <Target Name="DeployToSpt" AfterTargets="Build">
    <PropertyGroup>
      <SptModDirectory>$(MSBuildProjectDirectory)\..\..\..\SPT_Runtime\user\mods\SoloOverhaul\</SptModDirectory>
    </PropertyGroup>
    <MakeDir Directories="$(SptModDirectory)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SptModDirectory)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(SptModDirectory)" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
  </Target>
</Project>